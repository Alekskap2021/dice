{
  "name": "kosti",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Кости — аналог игры в кости из Kingdom Come: Deliverance (браузер + сетевая игра)",
  "scripts": {
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "build": "vite build",
    "start": "tsx server/index.ts",
    "test": "tsx --test shared/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "three": "^0.170.0",
    "tsx": "^4.19.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/three": "^0.170.0",
    "@types/ws": "^8.5.12",
    "concurrently": "^9.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
